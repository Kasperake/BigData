@page "/"
@using BigData.UI.Clients
@using BigData.UI.Clients.Models
@using BigData.UI.Components.Pages.Features
@inject IDialogService DialogService
@inject IWeatherClient WeatherClient

    <MudGrid>
        <MudItem>
        <MudDataGrid T="GetWeatherObservationsItem"
                     ServerData="@GetData"
                     RowsPerPage="@PageSize">

            <Columns>
                <PropertyColumn Property="x => x.Id" Title="Id" />
                <PropertyColumn Property="x => x.StationId" Title="Station" Filterable="true" />
                <PropertyColumn Property="x => x.Value" Title="Value" Filterable="true" />
                <PropertyColumn Property="x => x.Latitude" Title="Latitude" Filterable="true" />
                <PropertyColumn Property="x => x.Longitude" Title="Longitude" Filterable="true" />
                <PropertyColumn Property="x => x.ObservedAtUtc" Title="Observed At (UTC)" Filterable="true" />
                <PropertyColumn Property="x => x.CreatedAtUtc" Title="Created At (UTC)" Filterable="true" />
                <PropertyColumn Property="x => x.ParameterId" Title="Parameter Id" Filterable="true" />
                <TemplateColumn>
                    <CellTemplate>
                            <MudButton Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Primary" OnClick="@OpenDialogAsync">Details</MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="GetWeatherObservationsItem" />
            </PagerContent>
        </MudDataGrid>
            </MudItem>
    </MudGrid>

@code {
    private IEnumerable<GetWeatherObservationsItem> Items = [];
    private int PageSize = 20;

    private async Task<GridData<GetWeatherObservationsItem>> GetData(GridState<GetWeatherObservationsItem> state, CancellationToken ct)
    {
        var page = state.Page + 1;
        var pageSize = state.PageSize == 0 ? PageSize : state.PageSize;

        var result = await WeatherClient.GetAsync(page, pageSize, ct);

        return new GridData<GetWeatherObservationsItem>
        {
            Items = result.Items ?? [],
            TotalItems = result.TotalCount
        };
    }

    // Dialog for detail button
    private Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        return DialogService.ShowAsync<WeatherDetailsDialog>("Simple Dialog", options);
    }
}