@page "/"
@using BigData.UI.Clients
@using BigData.UI.Clients.Models
@using BigData.UI.Components.Pages.Features
@inject IDialogService DialogService
@inject IWeatherClient WeatherClient
@inject ISnackbar Snackbar

<PageTitle>Measurements</PageTitle>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info">No measurements available.</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudSelect T="string"
                       Label="Countries"
                       MultiSelection="true"
                       SelectAll="true"
                       SelectedValues="@_selectedCountries"
                       SelectedValuesChanged="@OnCountriesChanged"
                       Variant="Variant.Outlined">
                @foreach (var country in _countries)
                {
                    <MudSelectItem T="string" Value="@country">@country</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudSelect T="string"
                       Label="Stations"
                       MultiSelection="true"
                       SelectAll="true"
                       SelectedValues="@_selectedStations"
                       SelectedValuesChanged="@OnStationsChanged"
                       ToStringFunc="@StationLabel"
                       Variant="Variant.Outlined">
                @foreach (var station in VisibleStations)
                {
                    <MudSelectItem T="string" Value="@station.Id">@station.Label</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudSelect T="ParameterProfile"
                       Label="Parameter"
                       Value="@_selectedParameter"
                       ValueChanged="@OnParameterChanged"
                       ToStringFunc="@(p => p?.DisplayName ?? string.Empty)"
                       Variant="Variant.Outlined">
                @foreach (var parameter in _parameters)
                {
                    <MudSelectItem T="ParameterProfile" Value="@parameter">@parameter.DisplayName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12">
            <MeasurementLineChart Items="@_filteredItems" Profile="@_selectedParameter" />
        </MudItem>

        <MudItem xs="12">
            <MudDataGrid T="StationRow"
                         Items="@_stationRows"
                         RowsPerPage="20"
                         Dense="true"
                         SortMode="SortMode.Single">
                <Columns>
                    <HierarchyColumn T="StationRow" />
                    <PropertyColumn Property="x => x.StationName" Title="Station" />
                    <PropertyColumn Property="x => x.StationId" Title="Station Id" />
                    <PropertyColumn Property="x => x.CountryCode" Title="Country" />
                    <PropertyColumn Property="x => x.LatestObservedAtUtc" Title="Latest (UTC)" Format="yyyy-MM-dd HH:mm"
                                    InitialDirection="SortDirection.Descending" />
                    <PropertyColumn Property="x => x.Measurements.Count" Title="Measurements" />
                    @foreach (var parameter in _parameters)
                    {
                        <TemplateColumn T="StationRow" Title="@parameter.DisplayName" Sortable="false">
                            <CellTemplate>@FormatLatestValue(context.Item, parameter)</CellTemplate>
                        </TemplateColumn>
                    }
                </Columns>
                <ChildRowContent>
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead>
                            <tr>
                                <th>Observed At (UTC)</th>
                                @foreach (var parameter in _parameters)
                                {
                                    <th>@parameter.DisplayName</th>
                                }
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var measurement in context.Item.Measurements)
                            {
                                <tr>
                                    <td>@measurement.ObservedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                    @foreach (var parameter in _parameters)
                                    {
                                        <td>@FormatValue(measurement, parameter)</td>
                                    }
                                    <td>
                                        <MudButton Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Primary"
                                                   OnClick="@(() => OpenDialogAsync(measurement))">Details</MudButton>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </ChildRowContent>
                <PagerContent>
                    <MudDataGridPager T="StationRow" />
                </PagerContent>
            </MudDataGrid>
        </MudItem>
    </MudGrid>
}


